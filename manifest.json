{
  "manifest_version": 3,
  "name": "Ownference Tabs",
  "version": "0.1.0",
  "description": "Turn selected page text into answers, locally.",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:3210/*"],
  "action": { "default_title": "Ownference Tabs", "default_popup": "popup.html" },
  "options_page": "options.html"
}
