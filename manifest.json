{
  "manifest_version": 3,
  "name": "OwnMode Browser",
  "version": "0.3.0",
  "description": "Turn selected page text into answers, locally.",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage", "nativeMessaging"],
  "host_permissions": ["http://127.0.0.1:3210/*"],
  "background": { "service_worker": "src/relay-worker.js" },
  "icons": { "16": "docs/assets/icon-16.png", "32": "docs/assets/icon-32.png", "48": "docs/assets/icon-48.png", "128": "docs/assets/icon-128.png" },
  "action": { "default_title": "OwnMode Browser", "default_popup": "popup.html", "default_icon": { "16": "docs/assets/icon-16.png", "32": "docs/assets/icon-32.png" } },
  "options_page": "options.html"
}
